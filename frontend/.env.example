# Public API used by the Next.js client.
NEXT_PUBLIC_API_URL=http://localhost:5555/api/v1

# Published Google Form used for Level 5/6 onboarding and product feedback.
# The form should collect name, email, Stellar wallet address, a 1-5 rating,
# favorite feature, issues encountered, and requested improvements.
NEXT_PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_FORM_ID/viewform
